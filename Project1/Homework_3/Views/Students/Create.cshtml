@model Student
@{
    ViewData["Title"] = "Добавить ученика";
}
<h1>Добавить ученика</h1>
<form asp-action="Create" method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <label asp-for="Name"></label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="validation"></span>

    <label asp-for="SchoolId"></label>
    <select asp-for="SchoolId" asp-items="ViewBag.Schools">
        <option value="0">Выберите школу</option>
    </select>
    <span asp-validation-for="SchoolId" class="validation"></span>

    <label asp-for="AverageGrade"></label>
    <input asp-for="AverageGrade" type="number" min="0" step="0.01" />
    <span asp-validation-for="AverageGrade" class="validation"></span>

    <div class="form-actions">
        <button class="button primary" type="submit">Сохранить</button>
        <a class="button" asp-action="Index">Отмена</a>
    </div>
</form>
