@model IReadOnlyList<Student>
@{
    ViewData["Title"] = "Ученики";
}
<div class="page-heading">
    <div>
        <p class="eyebrow">Основная таблица</p>
        <h1>Ученики</h1>
    </div>
    <a class="button primary" asp-action="Create">Добавить ученика</a>
</div>
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert success">@success</div>
}
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>ФИО ученика</th>
            <th>Школа</th>
            <th>Средний балл</th>
            <th class="actions">Действия</th>
        </tr>
    </thead>
    <tbody>
    @foreach (Student student in Model)
    {
        <tr>
            <td>@student.Id</td>
            <td>@student.Name</td>
            <td>@student.School?.Name</td>
            <td>@student.AverageGrade.ToString("F2")</td>
            <td class="actions">
                <a asp-action="Edit" asp-route-id="@student.Id">Изменить</a>
                <a class="danger-link" asp-action="Delete" asp-route-id="@student.Id">Удалить</a>
            </td>
        </tr>
    }
    </tbody>
</table>
